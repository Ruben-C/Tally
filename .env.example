# Tally environment. Copy to `.env` (never commit .env) and fill in. Lines marked ▶ must be set or checked.

# ▶ Database password, used by both containers. Generate one: openssl rand -hex 32
POSTGRES_PASSWORD=

# ▶ AES-256-GCM key that encrypts Plaid access tokens at rest (64 hex chars). Generate: openssl rand -hex 32
#   Keep it with your backups: without the same key, stored bank connections can't be decrypted.
TOKEN_ENC_KEY=

# Where you open Tally. Passkeys are bound to RP_ID (the bare domain), so changing it later means
# registering a new passkey. Defaults (if unset): localhost / http://localhost:3000
#   Own domain:  RP_ID=money.example.com  ORIGIN=https://money.example.com   (needs HTTPS in front)
# RP_ID=
# ORIGIN=

# Optional: where the app is published on the host (default 127.0.0.1:3000, this machine only).
#   Use 3000 for all interfaces, or e.g. 127.0.0.1:8090 to change the port (then set ORIGIN to match).
# TALLY_BIND=

# Optional: uid / gid that own ./data (`id -u` / `id -g`), if not 1000.
# PUID=
# PGID=

# ▶ Plaid keys from dashboard.plaid.com → Developers → Keys. Leave CHANGEME to run on demo data only.
#   PLAID_ENV: sandbox (test logins user_good / pass_good) or production (real banks).
PLAID_CLIENT_ID=CHANGEME
PLAID_SECRET=CHANGEME
PLAID_ENV=sandbox

# Optional: needed for OAuth banks (e.g. Chase) in production. Register <ORIGIN>/plaid-oauth as an
# allowed redirect URI in the Plaid dashboard, then set the same value here.
# PLAID_REDIRECT_URI=https://money.example.com/plaid-oauth

# Optional: background Plaid sync interval in hours (0 disables). Webhooks are used automatically
# when ORIGIN is https://, so Plaid must be able to reach <ORIGIN>/api/plaid/webhook.
# SYNC_HOURS=6
